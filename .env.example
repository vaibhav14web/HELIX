# ── LLM Engine ──
HELIX_LLM_BACKEND=ollama
# Options: mock | ollama | llama.cpp | transformers
#   mock:        no model needed, returns canned responses (default)
#   ollama:      uses Ollama API (recommended — GPU accelerated, simple setup)
#   llama.cpp:   uses llama-cpp-python with GGUF models
#   transformers: uses HuggingFace transformers

HELIX_LLM_MODEL_NAME=qwen3:1.7b
# Model name/ID:
#   ollama:      the model tag in Ollama (e.g. qwen3:1.7b, llama3.2:3b)
#   transformers: HuggingFace model name (e.g. Qwen/Qwen2.5-1.5B-Instruct)

HELIX_LLM_OLLAMA_URL=http://localhost:11434
# Ollama API server URL (only used when HELIX_LLM_BACKEND=ollama)

HELIX_LLM_MODEL_PATH=models/qwen3/qwen3_1.7b_instruct.gguf
# Path to GGUF model file (only used for llama.cpp backend)

HELIX_LLM_CONTEXT_LENGTH=2048
# Max context window size in tokens

HELIX_LLM_MAX_TOKENS=512
# Max tokens to generate per response

HELIX_LLM_TEMPERATURE=0.7
# Generation temperature (0.0 = deterministic, 1.0 = creative)

HELIX_LLM_GPU_LAYERS=-1
# GPU layers for llama.cpp (-1 = auto, 0 = CPU only)

HELIX_LLM_IDLE_UNLOAD_SECONDS=300
# Unload model after N seconds idle (0 = keep loaded, no-op for ollama)

HELIX_LLM_STREAM=true
# Stream response tokens for real-time chat text (ollama backend only)

# ── Conversation Engine ──
HELIX_CONVERSATION_MAX_HISTORY=20
# Max conversation history entries to include in prompt

HELIX_CONVERSATION_SYSTEM_PROMPT=You are HELIX, a context-aware personal cognitive operating system. You are helpful, concise, and respect user privacy. Answer questions and assist with tasks. When you don't know something, say so.

HELIX_CONVERSATION_RESPONSE_TIMEOUT=30
# Max seconds to wait for LLM response before timeout

# ── Memory ──
HELIX_MEMORY_PATH=./data/memory
# Path for runtime memory storage (laptop SSD)

HELIX_MEMORY_ROLLING_DAYS=7
# Days before conversation data is auto-archived

# ── API ──
HELIX_API_HOST=0.0.0.0
# FastAPI server bind address

HELIX_API_PORT=8000
# FastAPI server port

HELIX_API_RELOAD=true
# Enable auto-reload on code changes

HELIX_CORS_ORIGINS=http://localhost:3000
# Comma-separated allowed CORS origins

HELIX_UI_PORT=3000
# Frontend dev server port

HELIX_UI_HOST=localhost
# Frontend dev server bind address
